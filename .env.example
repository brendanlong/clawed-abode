# Every variable the server reads, validated at startup by src/lib/env.ts (the
# server refuses to boot on an invalid value). Commented-out values are the
# defaults, or examples where there is no default.

# Fine-grained GitHub token scoped to only the repos agents should reach, with the
# permissions in doc/self-hosting.md ("Generate GitHub Token"). Create at:
# https://github.com/settings/personal-access-tokens/new
# Without it the repo/branch/issue pickers and PR status are unavailable.
GITHUB_TOKEN="github_pat_your_github_token_here"

# Claude Code OAuth token: run `claude setup-token` to generate (lasts a year).
# Can instead be set in the Settings UI.
CLAUDE_CODE_OAUTH_TOKEN="your_oauth_token_here"

# Password hash for authentication (base64-encoded); logins fail without it.
# Generate with: pnpm hash-password <yourpassword>
# The output is base64-encoded to avoid issues with $ characters in dotenv
PASSWORD_HASH="JGFyZ29uMmlkJHY9MTkkbT02NTUzNix0PTMscD00JHlvdXJfc2FsdF9oZXJlJHlvdXJfaGFzaF9oZXJl"

# 32+ character key for encrypting secrets (env vars, MCP API keys); required
# before any secret can be saved. Generate with: openssl rand -base64 32
# ENCRYPTION_KEY=

# SQLite database path
# DATABASE_URL="file:./data/dev.db"

# Default Claude model (e.g., "opus", "sonnet", "claude-opus-4-5-20251101"),
# overridable per repo or session in Settings
# CLAUDE_MODEL="opus[1m]"

# Branch prefix for session branches ("claude/" creates branches like "claude/{sessionId}")
# SESSION_BRANCH_PREFIX="claude/"

# Public URL the browser reaches this app on. Needed for MCP servers that
# authenticate with OAuth (where the authorization server sends the user back)
# and for the public files server's sign-in link. Leave unset to derive it from
# the proxy's forwarded host/proto, and the public files server's host on the
# default port, which is correct behind `tailscale serve 3000`.
# APP_URL="https://your-host.tailnet.ts.net"

# Base URL of a self-hosted code-server (browser VS Code) instance for viewing
# and editing session worktrees remotely. When set, each session shows an
# "Open in VS Code" button that deep-links into its worktree folder.
# Run scripts/setup-code-server.sh to install/run code-server, then
# scripts/expose-code-server-tailscale.sh (needs Tailscale access) to expose it
# and print the URL to use here. Leave unset to hide the button.
# CODE_SERVER_URL="https://your-host.tailnet.ts.net:8443"

# Serve each session's public/ directory (browser-viewable agent output) on its
# own loopback port. Set both or neither. The URL must be on the same hostname
# you reach the app on (the auth cookie is shared across ports, not hostnames).
# Run scripts/expose-public-files-tailscale.sh <port> to expose it and print both.
# PUBLIC_FILES_PORT=3001
# PUBLIC_FILES_URL="https://your-host.tailnet.ts.net:8444"

# Text-to-speech (Kokoro) through any OpenAI-compatible /audio/speech API that
# returns PCM. Leave TTS_BASE_URL unset to hide read-aloud. OpenRouter:
# TTS_BASE_URL="https://openrouter.ai/api/v1"
# TTS_API_KEY="sk-or-..."
# TTS_MODEL="hexgrad/kokoro-82m"
# Or a local Kokoro-FastAPI, no key (setup: "Read-aloud with local Kokoro" in doc/self-hosting.md):
# TTS_BASE_URL="http://localhost:8880/v1"
# TTS_MODEL="kokoro"
# One request at a time, so parallel requests don't compete for its CPU cores
# (it still synthesizes ahead of playback). Defaults to 4 for hosted providers.
# TTS_MAX_CONCURRENCY=1

# Collective limits on all agent sessions, in systemd syntax (see "Process Reaping"
# in doc/claude-sessions.md).
# Memory cap, e.g. 96G, 85% or infinity:
# SESSIONS_MEMORY_MAX="85%"
# Swap the sessions may use, in the same syntax:
# SESSIONS_MEMORY_SWAP_MAX="0"
# CPU cap, where 100% is one core (2200% leaves 2 of 24 free); no cap by default:
# SESSIONS_CPU_QUOTA="2200%"

# Minimum server log level: debug, info, warn, or error
# LOG_LEVEL="info"

# Anthropic-compatible proxy (LiteLLM) for non-Claude models like
# openai/gpt-6-astra. Setup: "Other model providers" in doc/self-hosting.md.
# LLM_PROXY_URL="http://127.0.0.1:4000"
# LLM_PROXY_KEY="sk-..."
