# Podman Quadlet unit for the LiteLLM proxy; see "Other model providers" in README.md.
[Unit]
Description=LiteLLM proxy for non-Claude models

[Container]
ContainerName=litellm
# Pinned by digest after the malicious litellm 1.107.0 release (supply chain
# attack, Oct 2026). Only bump after checking the new version for CVEs and
# security advisories, then update the README's login command to match.
Image=ghcr.io/berriai/litellm:v1.104.0@sha256:625981c83410a3ea68eb0697590a57ec1d764d634514d54fa5db0591077ee839
PublishPort=127.0.0.1:4000:4000
Volume=%h/.config/litellm/config.yaml:/app/config.yaml:ro,Z
# The ChatGPT login; writable because LiteLLM saves refreshed tokens back to it.
Volume=%h/.config/litellm/chatgpt:/chatgpt:z
Environment=CHATGPT_TOKEN_DIR=/chatgpt
Volume=%h/.config/litellm/litellm_chatgpt_hooks.py:/app/litellm_chatgpt_hooks.py:ro,Z
# Replaces the Codex CLI prompt LiteLLM puts ahead of every system prompt, which
# names Codex-only tools; the backend needs some instructions, but any will do.
Environment="CHATGPT_DEFAULT_INSTRUCTIONS=Follow the system instructions below."
# OPENAI_API_KEY and LITELLM_MASTER_KEY.
EnvironmentFile=%h/.config/litellm/env
Exec=--config /app/config.yaml --port 4000

[Service]
Restart=always
# The first start may pull the image.
TimeoutStartSec=900

[Install]
WantedBy=default.target
