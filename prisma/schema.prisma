generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// Has CHECK constraints (see McpServer): scope.
model AuthSession {
  id             String    @id @default(uuid())
  token          String    @unique
  // "full", or "public_files": accepted only by the public files server (see doc/security.md)
  scope          String    @default("full")
  expiresAt      DateTime
  lastActivityAt DateTime  @default(now())
  createdAt      DateTime  @default(now())
  revokedAt      DateTime? // When the session was revoked (null if not revoked)
  ipAddress      String?
  userAgent      String?

  @@index([expiresAt])
  @@index([revokedAt])
  @@index([createdAt, id])
}

model Session {
  id                 String    @id @default(uuid())
  name               String
  repoUrl            String? // null for no-repo sessions
  branch             String? // null for no-repo sessions
  repoPath           String    @default("") // Path to repo relative to workspace (e.g., "my-repo")
  status             String    @default("creating") // creating, running, stopped, error, archived
  statusMessage      String? // Human-readable progress message during creation
  currentBranch      String? // Current git branch (detected after each turn)
  pullRequest        String? // JSON PullRequestInfo for currentBranch; null = none/unknown (see src/lib/pull-request.ts)
  prCheckedAt        DateTime? // When GitHub was last asked about pullRequest, successfully or not; drives the staleness refresh (see src/lib/pull-request.ts)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  lastActivityAt     DateTime  @default(now()) // Bumped only on user interactions (prompt, answer); drives session-list ordering
  messageSequence    Int       @default(0) // Monotonic counter for atomic message sequence assignment (next sequence to assign)
  sessionScope       String? // systemd user scope unit this session's CLI runs in; recorded so a crash-restart can reap the exact orphaned scope (null when not scoped / after clean teardown)
  claudeModel        String? // If set, overrides the repo/global/env Claude model for this session only (highest precedence)
  claudeSessionId    String? // The Claude Code conversation to resume, recorded from each system/init (the CLI starts a new one on /clear). null = no conversation started yet, so the next query starts fresh
  agentName          String? // CLAUDE_CODE_SESSION_NAME: set once, so other sessions can address this one across restarts
  createdBySessionId String? // Session whose agent created this one with the create_session tool; such sessions never get the session-management tools

  // Rate-limit pause overrides; null means "inherit the global setting" (see src/lib/rate-limit.ts).
  rateLimitPauseEnabled   Boolean? // If set, overrides whether this session pauses when the subscription window fills
  rateLimitPauseThreshold Int? // If set, overrides the 5-hour-window utilization percent at which it pauses
  // Set when a turn was cut short by a rate-limit rejection, so the session is
  // nudged to continue once the window resets. Cleared when the nudge is sent.
  resumeAfterRateLimit    Boolean  @default(false)
  // Monotonic counter for atomic queued-prompt position assignment (next position to assign)
  queuedPromptSequence    Int      @default(0)

  messages      Message[]
  queuedPrompts QueuedPrompt[]
  usage         SessionUsage?

  @@index([lastActivityAt, id]) // sessions.list default keyset order (status != 'archived')
  @@index([status, lastActivityAt, id]) // sessions.list keyset order filtered by status
  @@index([agentName]) // sessions.byAgentName: linking a message to the session that sent it
}

// A user prompt held back while the session is paused for a subscription rate
// limit. The transcript bubble is already persisted (messageId); this row is what
// is pushed into the SDK once the window resets. See doc/rate-limit-pause.md.
// Has CHECK constraints (see McpServer): attachments.
model QueuedPrompt {
  id          String   @id @default(uuid())
  sessionId   String
  position    Int // Per-session queue order, assigned from Session.queuedPromptSequence
  messageId   String // The persisted transcript bubble this prompt already wrote
  content     String // Prepared (attachment-prefixed, sanitized) text to push into the SDK
  text        String // The user's original typed text, for restore-on-cancel
  attachments String // JSON array of stored upload names
  createdAt   DateTime @default(now())

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, position])
}

// Latest known state of each subscription usage window, account-wide. Persisted
// so a server restart doesn't release paused work into a still-exhausted window;
// rows whose resetsAt has passed are ignored and swept.
model RateLimitWindow {
  limitType   String   @id // "five_hour", "seven_day", ... (see HOLDABLE_LIMIT_TYPES)
  rejected    Boolean // The API was refusing requests against this window when observed
  utilization Float? // Percent of the window consumed, when reported
  resetsAt    DateTime
}

// Running token/cost totals, folded in as result and system/init messages are
// inserted so reading them never rescans the transcript (see src/server/services/session-usage.ts).
// A separate table so the counters stay out of every Session payload.
// Has CHECK constraints (see McpServer): contextWindows.
model SessionUsage {
  sessionId             String  @id
  resultCount           Int     @default(0)
  inputTokens           BigInt  @default(0) // Sum of per-turn result usage
  outputTokens          BigInt  @default(0)
  cacheReadTokens       BigInt  @default(0)
  cacheCreationTokens   BigInt  @default(0)
  closedSegmentsCostUsd Float   @default(0) // Final cumulative cost of each query process that has since reset
  currentSegmentCostUsd Float   @default(0) // Latest cumulative cost reported by the current query process
  contextWindows        String  @default("{}") // JSON: model -> latest reported context window
  model                 String? // From the first system/init

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model Message {
  id        String   @id @default(uuid())
  sessionId String
  sequence  Int
  type      String // system, user, assistant, result
  content   String // JSON stored as string
  createdAt DateTime @default(now())

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, sequence])
}

// Per-repository settings for favorites, env vars, and MCP servers
model RepoSettings {
  id                 String   @id @default(uuid())
  repoFullName       String   @unique // e.g., "owner/repo"
  isFavorite         Boolean  @default(false)
  customSystemPrompt String? // Optional prompt appended to the default system prompt
  claudeModel        String? // If set, overrides the global/env Claude model for this repo's sessions
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  envVars    EnvVar[]
  mcpServers McpServer[]

  @@index([isFavorite])
}

// Environment variables for a repository or global (some may be encrypted secrets)
// When repoSettingsId is null, the env var is global (applies to all sessions).
// Global name uniqueness is enforced by a partial unique index
// (EnvVar_global_name_key ... WHERE repoSettingsId IS NULL) written by hand in
// migration 20260208044452 because Prisma can't express partial indexes. Prisma's
// differ doesn't know it exists, so any generated migration that rebuilds this
// table (SQLite drops indexes with the table) must recreate it by hand.
//
// More generally: prefer hand-writing ALTER TABLE ADD COLUMN over the table
// rebuild Prisma's SQLite generator emits by default. A rebuild reprints the
// table's whole index set as of the day it was generated, so a later migration
// that adds or drops an index leaves the older file silently reinstating the old
// set (this happened to 20260908054900). ADD COLUMN covers any nullable column
// and any NOT NULL column with a constant default; check the result with
// `prisma migrate dev --create-only`, which yields an empty migration when the
// hand-written SQL matches the schema.
model EnvVar {
  id             String        @id @default(uuid())
  repoSettingsId String?
  repoSettings   RepoSettings? @relation(fields: [repoSettingsId], references: [id], onDelete: Cascade)
  name           String // e.g., "API_KEY"
  value          String // Encrypted if isSecret=true
  isSecret       Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([repoSettingsId, name])
  @@index([repoSettingsId])
}

// MCP server configurations for a repository or global
// When repoSettingsId is null, the MCP server is global (applies to all sessions).
// Same hand-written partial unique index as EnvVar (McpServer_global_name_key).
//
// CHECK constraints (hand-written in migrations; Prisma can't express them and its
// differ ignores them) mirror the Zod schemas these rows are parsed with, as
// src/server/services/db-check-constraints.integration.test.ts asserts. They exist
// on every model marked "Has CHECK constraints". A generated rebuild of such a
// table silently drops them, so recreate them by hand; changing a Zod enum needs a
// migration that rebuilds the table with the new list.
//
// Has CHECK constraints: type, authType, args, url.
model McpServer {
  id             String        @id @default(uuid())
  repoSettingsId String?
  repoSettings   RepoSettings? @relation(fields: [repoSettingsId], references: [id], onDelete: Cascade)
  name           String // Server name (key in mcpServers object)
  type           String        @default("stdio") // "stdio", "http", or "sse"
  command        String        @default("") // For stdio: e.g., "npx" (empty for http/sse)
  args           String? // For stdio: JSON array, e.g., '["@anthropic/mcp-server-memory"]'
  url            String? // For http/sse: server URL
  authType       String        @default("headers") // For http/sse: "headers" (static) or "oauth" (see McpOAuth)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  values McpServerValue[]
  oauth  McpOAuth?

  @@unique([repoSettingsId, name])
  @@index([repoSettingsId])
}

// One env var (stdio) or header (http/sse) of an MCP server. A row per value,
// rather than a JSON column, so a save can leave an unchanged secret untouched
// instead of reading it back to rewrite it.
// Has CHECK constraints (see McpServer): kind.
model McpServerValue {
  id          String    @id @default(uuid())
  mcpServerId String
  mcpServer   McpServer @relation(fields: [mcpServerId], references: [id], onDelete: Cascade)
  kind        String // "env" or "header"
  name        String
  value       String // Encrypted if isSecret=true
  isSecret    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([mcpServerId, kind, name])
}

// OAuth 2.1 grant for one http/sse MCP server (authType = "oauth"). One row per
// server row, so a global and a per-repo entry for the same remote server hold
// independent grants. Client secret, tokens and the in-flight PKCE verifier are
// encrypted with ENCRYPTION_KEY; see src/server/services/mcp-oauth.ts.
model McpOAuth {
  id          String    @id @default(uuid())
  mcpServerId String    @unique
  mcpServer   McpServer @relation(fields: [mcpServerId], references: [id], onDelete: Cascade)

  // Client registration: discovered endpoints plus the client we authenticate as
  // (registered via DCR, or entered by hand when the server has no DCR).
  issuer           String?
  tokenEndpoint    String?
  resource         String? // RFC 8707 resource indicator (the canonical MCP URL)
  scope            String? // Scope requested at /authorize; null = whatever the server defaults to
  clientId         String?
  clientSecret     String? // Encrypted
  clientIdIsManual Boolean @default(false) // Entered by the user, so never replaced by DCR

  // In-flight authorization (cleared once the callback completes)
  flowState     String?   @unique // The OAuth `state`; the callback's only credential
  codeVerifier  String? // Encrypted PKCE verifier
  redirectUri   String? // Exact value sent to /authorize, replayed at /token
  flowStartedAt DateTime?

  // Tokens
  accessToken  String? // Encrypted
  refreshToken String? // Encrypted
  expiresAt    DateTime? // Access-token expiry
  authorizedAt DateTime? // Last successful authorization-code exchange
  lastError    String? // Why the most recent connect/refresh failed; null when healthy

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Global application settings (singleton - only one row)
model GlobalSettings {
  id                          String   @id @default("global") // Singleton pattern
  systemPromptOverride        String? // If set, replaces the default system prompt
  systemPromptOverrideEnabled Boolean  @default(false) // Whether to use the override
  systemPromptAppend          String? // Additional content appended after default/override prompt
  claudeModel                 String? // If set, overrides CLAUDE_MODEL env var
  advisorModel                String? // Model for the server-side advisor tool. Null (the default) disables the advisor tool.
  claudeApiKey                String? // If set (encrypted), overrides CLAUDE_CODE_OAUTH_TOKEN env var
  ttsSpeed                    Float? // TTS playback speed (0.25-4.0, default 1.0)
  ttsVoice                    String? // Kokoro voice id; null uses DEFAULT_KOKORO_VOICE
  voiceAutoSend               Boolean  @default(true) // Auto-send after speech-to-text transcription
  settingSourceUser           Boolean  @default(false) // Load Claude settings from the user scope (~/.claude): skills, CLAUDE.md, hooks
  settingSourceProject        Boolean  @default(true) // Load Claude settings from the project scope (<cwd>/.claude)
  settingSourceLocal          Boolean  @default(false) // Load Claude settings from the local scope (<cwd>/.claude/settings.local.json)
  rateLimitPauseEnabled       Boolean  @default(false) // Default for whether sessions pause when a subscription window fills
  rateLimitPauseThreshold     Int      @default(95) // Default 5-hour-window utilization percent at which sessions pause
  builtinToolsEnabled         Boolean  @default(true) // Give agents the built-in clawed-abode MCP server (rename own session)
  sessionToolsEnabled         Boolean  @default(false) // Also give it tools to create, read, and stop other sessions
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt
}
