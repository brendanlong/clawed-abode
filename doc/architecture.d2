# Clawed Abode - Architecture Diagram

direction: right

# External clients
mobile: Mobile/Web Browser

# Tailscale
tailscale: Tailscale Serve/Funnel {
  style.fill: "#4A5568"
}

# Home Server
server: Home Server {
  style.fill: "#E8F4FD"

  app: Next.js + tRPC {
    style.fill: "#0070F3"
    style.font-color: white

    auth: Auth
    session_mgmt: Session Management
    sdk: "Claude Agent SDK (in-process, one streaming query per session)"
    sse: "SSE to Browser (multiplexed per-session + global list streams)"
    upload: POST /api/upload
  }

  scopes: systemd user scopes {
    style.fill: "#805AD5"
    style.font-color: white
    scope1: "clawed-session-{sessionId1}.scope: claude CLI + everything it spawns"
  }

  workspaces: "~/worktrees/{sessionId}/" {
    style.fill: "#48BB78"
    style.font-color: white

    clone: "{repo}/ (git clone, session branch)" {
      style.fill: "#38A169"
    }
    uploads: "uploads/ (attachments, sibling of the clone)" {
      style.fill: "#38A169"
    }
    mcp: "mcp-config.json (mode 0600, decrypted MCP secrets)" {
      style.fill: "#38A169"
    }
  }

  code_server: "code-server (optional, CODE_SERVER_URL)" {
    style.fill: "#2B6CB0"
    style.font-color: white
  }

  db: SQLite {
    style.fill: "#F6E05E"

    sessions: Sessions
    messages: Messages
    settings: Settings
  }
}

# Connections
mobile -> tailscale: HTTPS
tailscale -> server.app: HTTP

server.app.sdk -> server.scopes: "systemd-run --user --scope"
server.scopes -> server.workspaces.clone: "cwd"
server.app.sdk -> server.workspaces.mcp: "--mcp-config"
server.app.upload -> server.workspaces.uploads: "write"
server.app.session_mgmt -> server.db: "read/write"
server.app.sdk -> server.db.messages: "persist"
server.app.sse -> mobile: "stream events (resume via lastEventId)"
mobile -> server.code_server: "Open in VS Code (tailnet only)"
server.code_server -> server.workspaces: "edit"

# Data model: prisma/schema.prisma is the source of truth (see DESIGN.md).

# Session Lifecycle
lifecycle: Session Lifecycle {
  style.fill: "#F0FFF4"

  create: Create {
    style.fill: "#C6F6D5"
    1: "User selects repo + branch"
    2: "Server clones to ~/worktrees/{id}/{repo} in the background"
    3: "Session status → running; optional initial prompt sent server-side"
  }

  interact: Interact {
    style.fill: "#BEE3F8"
    1: "User sends prompt via tRPC"
    2: "Push to the session's persistent streaming query() (revive w/ resume if needed)"
    3: "canUseTool handles AskUserQuestion"
    4: "Messages stream via SSE; query stays alive across turns"
    5: "Background tasks survive turn end (indicator only; never gate input)"
  }

  stop: Stop {
    style.fill: "#FEFCBF"
    1: "Interrupt = current turn only (query stays alive)"
    2: "Stop = close query; session status → stopped"
    3: "Worktree preserved on disk"
  }

  archive: Archive {
    style.fill: "#FED7D7"
    1: "Stop query if running"
    2: "Remove ~/worktrees/{id}/"
    3: "Session status → archived"
    4: "Messages preserved in DB"
  }

  create -> interact: "ready"
  interact -> stop: "user stops"
  stop -> interact: "user restarts"
  interact -> archive: "user deletes"
  stop -> archive: "user deletes"
}
